---
interface Props {
    title: string;
    underConstruction?: boolean;
    guestbook?: boolean;
}

const { title, underConstruction = false, guestbook = false } = Astro.props;
---

<div class="y2k-title-bar">{title}</div>
<div class="y2k-panel">
    {
        underConstruction && (
            <p class="mb-4 text-center">
                <span class="y2k-construction">
                    <span class="y2k-blink" aria-hidden="true">
                        ⚠
                    </span>{" "}
                    UNDER CONSTRUCTION{" "}
                    <span class="y2k-blink" aria-hidden="true">
                        ⚠
                    </span>
                </span>
            </p>
        )
    }

    {
        guestbook ? (
            <div>
                <p class="mb-4 font-bold text-center">
                    ★ Sign my guestbook! ★
                </p>
                <form aria-label="Guestbook form (decorative)">
                    <label class="y2k-guestbook-label" for="guestbook-name">
                        Your Name:
                    </label>
                    <input
                        id="guestbook-name"
                        class="y2k-guestbook-field mb-3"
                        type="text"
                        disabled
                        placeholder="Anonymous Coward"
                    />
                    <label class="y2k-guestbook-label" for="guestbook-message">
                        Your Message:
                    </label>
                    <textarea
                        id="guestbook-message"
                        class="y2k-guestbook-field mb-3"
                        rows="4"
                        disabled
                        placeholder="Cool site bro!!!"
                    />
                    <button type="button" class="y2k-btn" disabled>
                        Sign Guestbook
                    </button>
                </form>
                <p class="mt-4 text-xs">
                    (Guestbook coming soon — no data is collected yet)
                </p>
            </div>
        ) : (
            <slot />
        )
    }
</div>
