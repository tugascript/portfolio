---
import AboutMe from "./cv/AboutMe.astro";
import MySummary from "./cv/MySummary.astro";
import Devider from "./common/Devider.astro";
import AllSkills from "./cv/AllSkills.astro";
import ProjectCollection from "./portfolio/ProjectCollection.astro";
import opensourceData from "../common/data/opensource.json";
import type { OpenSourceProject } from "../common/types";

const featuredProjects = (opensourceData as OpenSourceProject[]).filter(
  (project) => project.highlighted,
);
---

<AboutMe />
<Devider />
<MySummary />
<Devider />
<AllSkills />
<Devider />
<ProjectCollection
  id="featured-projects"
  title="Free work I've done"
  eyebrow=""
  projects={featuredProjects}
  featured
/>
