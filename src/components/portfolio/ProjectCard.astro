---
import type { OpenSourceProject } from "../../common/types";

interface Props {
  project: OpenSourceProject;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { urls } = project;
const tags = project.tags ?? [];
const languages = project.languages ?? [];
const frameworks = project.frameworks ?? [];
const libraries = project.libraries ?? [];
const tools = project.tools ?? [];
const contributions = urls.contributionUrls ?? [];

const formatDate = ({ month, year }: OpenSourceProject["startDate"]) =>
  month
    ? new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(
        new Date(year, month - 1),
      )
    : String(year);

const pullRequestLabel = (url: string) => {
  const match = url.match(/\/pull\/(\d+)/);
  return match ? `PR #${match[1]}` : "Pull request";
};

const timeline = project.endDate
  ? `${formatDate(project.startDate)} - ${formatDate(project.endDate)}`
  : `${formatDate(project.startDate)} - now`;

const stack = [...languages, ...frameworks, ...libraries, ...tools].filter(
  (item, index, values) => values.indexOf(item) === index,
);

const links = [
  { label: "Source code", href: urls.repositoryUrl, external: true },
  { label: "Package", href: urls.packageUrl, external: true },
  { label: "Docs", href: urls.documentationUrl, external: true },
  { label: "Website", href: urls.websiteUrl, external: true },
  { label: "DEV series", href: urls.devToSeriesUrl, external: true },
  { label: "Hackathon", href: urls.hackathonUrl, external: true },
  { label: "Blog series", href: urls.internalSeriesBlogPath, external: false },
  { label: "Issue", href: urls.issueUrl, external: true },
].filter((link): link is { label: string; href: string; external: boolean } =>
  Boolean(link.href),
);

if (contributions.length === 1) {
  const [contribution] = contributions;
  links.push({
    label: "Pull request",
    href: contribution.pullRequestUrl,
    external: true,
  });
  if (contribution.issueUrl) {
    links.push({
      label: "Issue",
      href: contribution.issueUrl,
      external: true,
    });
  }
}

const showContributionsAccordion = contributions.length > 1;
const showLinksNav = links.length > 0 || showContributionsAccordion;
---

<article
  class:list={["y2k-project-card", { "y2k-project-card--featured": featured }]}
>
  <header class="y2k-project-card__titlebar">
    <span aria-hidden="true">{project.highlighted ? "★" : "▣"}</span>
    <h3>{project.name}</h3>
    <span class="y2k-project-card__controls" aria-hidden="true"
      >— <b>□</b> x</span
    >
  </header>

  <div class="y2k-project-card__body">
    <div class="y2k-project-card__meta">
      <span
        class:list={[
          "y2k-project-status",
          `is-${project.status.toLowerCase()}`,
        ]}
      >
        {project.status}
      </span>
      <span>{project.role}</span>
      <span>{timeline}</span>
    </div>

    <p class="y2k-project-card__summary">{project.summary}</p>

    {
      tags.length > 0 && (
        <ul class="y2k-project-tags" aria-label={`${project.name} topics`}>
          {tags.map((tag) => (
            <li>#{tag}</li>
          ))}
        </ul>
      )
    }

    <details class="y2k-project-details">
      <summary>stack-tech-specs.txt</summary>
      <dl>
        <div>
          <dt>Primary</dt>
          <dd>{project.primaryLanguage}</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>{stack.join(" · ") || "No dependencies listed"}</dd>
        </div>
        <div>
          <dt>Storage</dt>
          <dd>{project.databases.join(" · ") || "No databases listed"}</dd>
        </div>
      </dl>
    </details>

    {
      showLinksNav && (
        <nav class="y2k-project-links" aria-label={`${project.name} links`}>
          {links.map((link, index) => (
            <a
              class="y2k-btn"
              href={link.href}
              {...(link.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {index === 0 ? "> " : ""}
              {link.label}
            </a>
          ))}
          {showContributionsAccordion && (
            <details class="y2k-project-contributions">
              <summary class="y2k-btn">
                {links.length === 0 ? "> " : ""}Contributions (
                {contributions.length})
                <span class="y2k-project-contributions-icon" aria-hidden="true">
                  <span class="y2k-project-contributions-icon-open">V</span>
                  <span class="y2k-project-contributions-icon-close">X</span>
                </span>
              </summary>
              <ul>
                {contributions.map((entry) => (
                  <li>
                    <a
                      href={entry.pullRequestUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {pullRequestLabel(entry.pullRequestUrl)}
                    </a>
                    {entry.issueUrl && (
                      <a
                        href={entry.issueUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Issue
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          )}
        </nav>
      )
    }
  </div>
</article>
