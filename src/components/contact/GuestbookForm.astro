---
import WindowsButtonDecoration from "../common/WindowsButtonDecoration.astro";
---

<section id="guestbook-form">
  <div class="y2k-title-bar">
    <h1 id="contact-me-title">Guestbook.app</h1>
    <WindowsButtonDecoration />
  </div>

  <div class="y2k-panel">
    <p class="mb-4 font-bold text-center">★ Sign my guestbook! ★</p>

    <form aria-label="Guestbook form (decorative)">
      <label class="y2k-guestbook-label" for="guestbook-name">
        Your Name:
      </label>
      <input
        id="guestbook-name"
        class="y2k-guestbook-field mb-3"
        type="text"
        disabled
        placeholder="Cool Recruiter From Cool Company"
      />
      <label class="y2k-guestbook-label" for="guestbook-email">
        E-Mail Address:
      </label>
      <input
        id="guestbook-email"
        class="y2k-guestbook-field mb-3"
        type="email"
        disabled
        placeholder="nigerian.prince@totally-not-a-scam.co.nz"
      />
      <label class="y2k-guestbook-label" for="guestbook-message">
        Your Message:
      </label>
      <textarea
        id="guestbook-message"
        class="y2k-guestbook-field mb-3"
        rows="6"
        disabled
        placeholder="Cool site bruv!!! You're hired!"></textarea>
      <button type="button" class="y2k-btn" disabled>► Sign Guestbook</button>
    </form>
  </div>
</section>
