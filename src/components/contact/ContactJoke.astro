---
import UnderConstruction from "./UnderConstruction.astro";
import WindowsButtonDecoration from "../common/WindowsButtonDecoration.astro";
---

<section id="contact-joke">
  <div class="y2k-title-bar">
    <h2 id="contact-joke-title" aria-label="Meanwhile">Error.exe</h2>
    <WindowsButtonDecoration />
  </div>

  <div class="y2k-panel">
    <div class="y2k-contact-joke">
      <p class="y2k-contact-joke__intro">
        Sh*t, wrong extension. This is Windows 98 not Mac OS X Public Beta! Like
        Auckland infrastructure it's always...
      </p>
      <br />

      <UnderConstruction />

      <p class="y2k-contact-joke__cta">
        While you wait, why don't you contact me on <a
          href="https://www.linkedin.com/in/afonso-barracha/"
          target="_blank">LinkedIn</a
        >, or check out my <a
          href="https://nz.seek.com/profiles/afonso-barracha-cn01p7463z"
          target="_blank">SEEK profile</a
        > if you're here to offer me dollars?
      </p>
    </div>
  </div>
</section>
