---
import { Image } from "astro:assets";
import profilePhoto from "../../assets/afonso_intro.jpg";
import WindowsButtonDecoration from "../common/WindowsButtonDecoration.astro";

const name: string = "Afonso Barracha";

const summary: string[][] = [
  [
    "Southern European Quantitive Developer hopeful turned into the Pacific's most employable Software Engineer, personally endorsed by the PM himself!",
    "At least in my dreams...",
  ],
  [
    'After enough segfaults and null pointers, I moved from C and the interpreted snake language to fancier languages that you can read in the "My tech stack.exe" executable, in an infinite quest for employability.',
  ],
  [
    "Currently wrangling with a Digital Identity platform at MATTR because I once forgot my physical driver's licence and the bouncer didn't let me in.",
    "With the release of Windows XP, I've set my sights on ML/AI closer to the metal with Rust, C++ and Python.",
  ],
];

const profilePictureDescription: string = "professionally-pondering.jpeg";
---

<section id="my-summary">
  <div class="y2k-title-bar">
    <h2 id="my-summary-title">Who am I?</h2>
    <WindowsButtonDecoration />
  </div>
  <div class="y2k-panel">
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start">
      <figure class="w-full max-w-[12rem] shrink-0">
        <div class="y2k-photo-frame">
          <Image
            src={profilePhoto}
            alt={`Portrait of ${name}`}
            class="aspect-[3/4] w-full object-cover object-top"
            widths={[288, 576]}
            sizes="(min-width: 640px) 12rem, 100vw"
          />
        </div>
        <figcaption class="mt-1 text-center text-xs font-bold">
          {profilePictureDescription}
        </figcaption>
      </figure>

      <div class="min-w-0 flex-1">
        {
          summary.map((paragraph) => (
            <p class="mb-3 last:mb-0">{paragraph.join(" ")}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>
