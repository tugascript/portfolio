---
import type { OpenSourceProject } from "../../common/types";

interface Props extends OpenSourceProject {}

const {
  name,
  summary,
  status,
  role,
  repositoryUrl,
  languages = [],
  frameworks = [],
  libraries = [],
} = Astro.props;

const frameworksAndLibraries = [...frameworks, ...libraries];
---

<article class="y2k-skill-card">
  <header class="y2k-skill-header">
    <p class="y2k-skill-title">
      <span class="y2k-skill-meme">
        {
          repositoryUrl ? (
            <a
              href={repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${name} repository`}
            >
              {name}
            </a>
          ) : (
            name
          )
        }
      </span>
      <span class="y2k-skill-real-name">({status} · {role})</span>
    </p>
  </header>

  <p class="y2k-opensource-summary">{summary}</p>

  {
    languages.length > 0 && (
      <div class="y2k-skill-group">
        <p class="y2k-skill-group-label">Languages</p>
        <ul class="y2k-skill-tags" aria-label={`${name} languages`}>
          {languages.map((language) => (
            <li class="y2k-skill-tag y2k-skill-tag--known">{language}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    frameworksAndLibraries.length > 0 && (
      <div class="y2k-skill-group">
        <p class="y2k-skill-group-label y2k-skill-group-label--learning">
          Frameworks &amp; libraries
        </p>
        <ul
          class="y2k-skill-tags"
          aria-label={`${name} frameworks and libraries`}
        >
          {frameworksAndLibraries.map((item) => (
            <li class="y2k-skill-tag y2k-skill-tag--learning">{item}</li>
          ))}
        </ul>
      </div>
    )
  }
</article>
