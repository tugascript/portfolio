---
// Import order matters: global CSS first so it has the lowest precedence
//(see "Cascading Order" in Astro's styling docs).
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Y2KFooter from "./Y2KFooter.astro";
const { title = "TugaScript" } = Astro.props;
---

<html lang="en">
  <head>
    <script is:inline>
      document.documentElement.setAttribute(
        "data-theme",
        localStorage.getItem("tugascript-theme") === "dark" ? "dark" : "light",
      );
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="y2k-page">
    <div class="y2k-container">
      <div class="y2k-frame">
        <Navbar />
        <main>
          <slot />
        </main>
        <Y2KFooter />
      </div>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
